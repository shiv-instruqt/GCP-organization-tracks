#!/bin/bash
# Check script (t_org_policy) - every condition must pass; the first failure is shown to the learner.
# shellcheck disable=SC1091
source /opt/lab/lib.sh 2>/dev/null || { echo "FAIL: The lab environment is still being prepared - wait a minute and click Check again."; exit 1; }
fail() { echo "FAIL: $*"; exit 1; }

check_one() {

case "$CHECK" in
  read_policies)
    grep -Eq "gcloud .*resource-manager org-policies (list|describe)" "$LOG" 2>/dev/null \
      || fail "No 'gcloud resource-manager org-policies list/describe' in commands.log yet." ;;
  guardrail_tested)
    grep -E "gcloud .*services enable" "$LOG" 2>/dev/null | grep -E '\| exit=[1-9][0-9]* \|' | grep -q "compute\|googleapis" \
      || fail "Try enabling an API that is not allowed (e.g. gcloud services enable compute.googleapis.com) - it must be refused." ;;
  boundary_tested)
    grep -F "| acting-as=$CI_DEPLOYER |" "$LOG" 2>/dev/null | grep -E '\| exit=[1-9][0-9]* \|' \
      | grep -Eq "DEV_BUCKET|$DEV_BUCKET" \
      || fail "No denied attempt by ci-deployer to read gs://$DEV_BUCKET in commands.log." ;;
  notes)
    f="$W1/04-org-policy-quotas.md"
    [ -f "$f" ] || fail "04-org-policy-quotas.md not found."
    grep -Eq "(iam|gcp|storage|compute|run|sql|essentialcontacts|resourcemanager)\.[a-zA-Z]{4,}" "$f" \
      || fail "Name at least one constraint (e.g. iam.disableServiceAccountKeyCreation) in 04-org-policy-quotas.md."
    no_todo "$f" || fail "04-org-policy-quotas.md still contains _TODO_ placeholders." ;;
  *) fail "Unknown check '$CHECK'" ;;
esac
}

for CHECK in read_policies guardrail_tested boundary_tested notes; do
  echo "Checking: $CHECK"
  check_one
done
echo "All checks passed - well done!"
exit 0
